<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shortcuts live in the shared container so widgets and controls can show them. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(BUNDLE_ID_PREFIX).app</string>
	</array>
	<!-- The phone's TLS identity lives in the Keychain; without an access group a build
	     fails with "A required entitlement isn't present". -->
	<!-- Same as PocketDesk.entitlements, plus push. Used when the team allows it (see
	     PD_APP_ENTITLEMENTS in Config/Signing.xcconfig).
	     Lets a Mac start and update the Now Playing Live Activity by push. Xcode switches it
	     to production when a build is signed for TestFlight or the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(BUNDLE_ID_PREFIX).app</string>
	</array>
</dict>
</plist>
