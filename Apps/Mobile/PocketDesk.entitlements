<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The phone's TLS identity lives in the Keychain; without an access group a build
	     fails with "A required entitlement isn't present". -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.pocketdesk.app</string>
	</array>
</dict>
</plist>
